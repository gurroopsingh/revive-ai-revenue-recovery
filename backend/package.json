{
  "name": "revive-ai-backend",
  "version": "1.0.0",
  "description": "REVIVE AI – Autonomous Revenue Recovery Agent Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --experimental-sqlite --import tsx src/index.ts",
    "build": "tsc",
    "start": "node --experimental-sqlite dist/index.js",
    "test": "node --experimental-sqlite --no-warnings node_modules/jest/bin/jest.js --runInBand",
    "seed": "node --experimental-sqlite --import tsx src/data/seed.ts",
    "evaluate": "node --experimental-sqlite --import tsx src/evaluation/pipeline.ts",
    "test:razorpay": "node --import tsx tests/razorpay.live.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "uuid": "^10.0.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.5.5",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
