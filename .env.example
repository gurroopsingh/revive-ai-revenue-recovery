# REVIVE AI Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development

# Gemini AI (get key from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Database (SQLite path relative to backend/)
DATABASE_PATH=./revive.db

# Agent Configuration
AGENT_CONFIDENCE_THRESHOLD=0.65
AGENT_HUMAN_APPROVAL_THRESHOLD=0.40
MAX_RETRY_ATTEMPTS=3
COOLDOWN_PERIOD_HOURS=24
MAX_CONTACT_PER_WEEK=3
MAX_TRANSACTION_LIMIT_INR=500000

# Razorpay (optional – for real API integration)
# RAZORPAY_KEY_ID=rzp_test_xxxxx
# RAZORPAY_KEY_SECRET=xxxxx

# Kill Switch
KILL_SWITCH_ENABLED=false

# Logging
LOG_LEVEL=info
