# REVIVE AI Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development

# Gemini AI (get key from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Database (SQLite path relative to backend/)
DATABASE_PATH=./revive.db

# Agent Configuration
AGENT_CONFIDENCE_THRESHOLD=0.65
AGENT_HUMAN_APPROVAL_THRESHOLD=0.40
MAX_RETRY_ATTEMPTS=3
COOLDOWN_PERIOD_HOURS=24
MAX_CONTACT_PER_WEEK=3
MAX_TRANSACTION_LIMIT_INR=500000

# Razorpay Test Mode (get test keys from https://dashboard.razorpay.com/app/keys)
# KEY_ID MUST start with rzp_test_ — the integration will refuse to run with live keys
# Without these, execution defaults to SIMULATION mode (no real API calls)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
# Optional: for webhook signature verification (POST /api/razorpay/webhook)
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Kill Switch
KILL_SWITCH_ENABLED=false

# Logging
LOG_LEVEL=info
